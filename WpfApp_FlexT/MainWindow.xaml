<Window x:Class="WpfApp_FlexT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_FlexT"
        mc:Ignorable="d"
        xmlns:qpanel="clr-namespace:QSoft.WPF.Panel;assembly=QSoft.WPF.Panel"
        xmlns:webview="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MainWindow" Height="770" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Selection area. There are too many test cases for one list, so they are narrowed down first: by category (the
             part of the file name before its first "_") and by search keywords, which the search box suggests while they
             are typed. The ComboBox lists what is left, and the content of the chosen test case is shown below it as
             editable JSON (the same shape as the TestCase\*.json files): typing valid FlexPanelTestData JSON re-renders
             both sides live (see MainWindow.xaml.cs's ContentEditTimer_Tick), but it is never written back to the file,
             so switching test cases (or reloading) always reverts to what is on disk.
             The content box has a fixed height (longer text scrolls) for the same reason as the result list below: a
             change of height would resize the two panes, which would leave the web page laid out in a viewport that no
             longer matches the WPF one. The window Height includes this area, so when the box gets another height the
             window needs the same change to leave the panes the size they have now (429 x 326). -->
        <Grid Grid.Row="0" Margin="4,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style x:Key="FieldLabel" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="2,0,8,0"/>
                </Style>
                <!-- A suggestion under the search box. It cannot take the keyboard focus, so a click leaves the focus in the box,
                     and the picked one is highlighted although the list never has the focus. -->
                <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#CCE8FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <TextBlock Text="分類" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="combobox_category" Grid.Column="1" DisplayMemberPath="DisplayName"
                      Margin="2" Padding="4,3" SelectionChanged="combobox_category_SelectionChanged"/>
            <TextBlock Grid.Column="2" Text="搜尋" Style="{StaticResource FieldLabel}" Margin="10,0,8,0"/>
            <Grid Grid.Column="3" Margin="2">
                <TextBox x:Name="textbox_search" Padding="2,3" VerticalContentAlignment="Center"
                         GotKeyboardFocus="textbox_search_GotKeyboardFocus" LostKeyboardFocus="textbox_search_LostKeyboardFocus"
                         PreviewKeyDown="textbox_search_PreviewKeyDown" SelectionChanged="textbox_search_SelectionChanged"
                         AutomationProperties.Name="搜尋" TextChanged="textbox_search_TextChanged"/>
                <TextBlock Text="輸入關鍵字篩選 (例: Column SpaceAround)" Foreground="Gray" Margin="6,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=textbox_search}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- The suggestions for the word being typed. A popup, so that the list can cover the web view (a window of its
                     own, which hides any element drawn over it) and does not change the size of the selection area. The list
                     is some dozens of rows at most, so none of them is virtualized: every row exists for UI Automation. -->
                <Popup x:Name="popup_suggestions" PlacementTarget="{Binding ElementName=textbox_search}" Placement="Bottom"
                       StaysOpen="True">
                    <Border Width="{Binding ActualWidth, ElementName=textbox_search}" BorderThickness="1"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                        <ListBox x:Name="listbox_suggestions" MaxHeight="240" BorderThickness="0" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False"
                                 AutomationProperties.Name="搜尋建議"
                                 ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                                 PreviewMouseLeftButtonDown="listbox_suggestions_PreviewMouseLeftButtonDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Text}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0} 筆}" Foreground="Gray" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
            <TextBlock x:Name="textblock_count" Grid.Column="4" Style="{StaticResource FieldLabel}" Margin="8,0,2,0"/>

            <TextBlock Grid.Row="1" Text="測試案例" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="combobox_testcase" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="DisplayName"
                      Margin="2" Padding="4,3" SelectionChanged="combobox_testcase_SelectionChanged"/>
            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                <Button x:Name="button_prev" Content="上一個" Margin="2" Padding="10,3" Click="button_prev_Click"/>
                <Button x:Name="button_next" Content="下一個" Margin="2" Padding="10,3" Click="button_next_Click"/>
                <Button x:Name="button_recompare" Content="重新比對" Margin="2" Padding="10,3" Click="button_recompare_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="內容" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="2,6,8,0"/>
            <TextBox x:Name="textbox_content" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Height="136" Margin="2" Padding="4,2"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Background="White"
                     AutomationProperties.Name="測試案例內容 (JSON，可編輯，不會寫回檔案)"
                     TextChanged="textbox_content_TextChanged"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="scrollviewer_flexpanel" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                <qpanel:FlexPanel x:Name="flexpanel"/>
            </ScrollViewer>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock TextAlignment="Center" VerticalAlignment="Center">
                    <Run Text="WPF"/><LineBreak/>
                    <Run Text="←"/>
                </TextBlock>
                <TextBlock Grid.Row="1" TextAlignment="Center" VerticalAlignment="Center">
                    <Run Text="Web"/><LineBreak/>
                    <Run Text="→"/>
                </TextBlock>
            </Grid>
            
            <webview:WebView2 x:Name="web" Grid.Column="2"/>
        </Grid>
        <!-- Reports each flex item's WPF vs. web-rendered (X, Y, Width, Height), populated by
             MainWindow.xaml.cs's ApplyTestCase/CompareAndShow after every test-case render.
             The list height is fixed so that emptying/refilling it never resizes the two panes above,
             which would leave the web page laid out in a viewport that no longer matches the WPF one. -->
        <StackPanel Grid.Row="2" Margin="4">
            <TextBlock x:Name="textblock_summary" FontWeight="Bold" Margin="0,2"/>
            <ListView x:Name="listview_comparison" Height="180">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" Width="30" DisplayMemberBinding="{Binding Index}"/>
                        <GridViewColumn Header="WPF (X, Y, W, H)" Width="200" DisplayMemberBinding="{Binding WpfRect}"/>
                        <GridViewColumn Header="Web (X, Y, W, H)" Width="200" DisplayMemberBinding="{Binding WebRect}"/>
                        <GridViewColumn Header="Diff (X, Y, W, H)" Width="180" DisplayMemberBinding="{Binding DeltaRect}"/>
                        <GridViewColumn Header="結果" Width="80" DisplayMemberBinding="{Binding StatusText}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                <Setter Property="Background" Value="#FBD9D9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                <Setter Property="Background" Value="#DCF3DC"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </StackPanel>
    </Grid>
</Window>
