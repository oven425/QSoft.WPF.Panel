<Window x:Class="WpfApp_FlexT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_FlexT"
        mc:Ignorable="d"
        xmlns:qpanel="clr-namespace:QSoft.WPF.Panel;assembly=QSoft.WPF.Panel"
        xmlns:webview="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MainWindow" Height="770" Width="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- The left column lists the test cases. The window Width includes it, so the two panes stay as wide as they were
             before the list was added (429 px each). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- There are too many test cases for a drop-down list, so those the category and the search keywords leave are listed
             here. Choosing one shows it on the right. -->
        <Grid Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <DockPanel Margin="4,2">
                <TextBlock DockPanel.Dock="Left" Text="分類" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <ComboBox x:Name="combobox_category" DisplayMemberPath="DisplayName" Margin="2" Padding="4,3"
                          AutomationProperties.Name="分類" SelectionChanged="combobox_category_SelectionChanged"/>
            </DockPanel>
            <!-- The descriptions are long, so they wrap instead of scrolling sideways. The paddings are small because the widest
                 word (JustifyContent=SpaceBetween,) leaves little room in 200 px, and a word that does not fit is broken in the
                 middle. The chosen item keeps a clear highlight while the list does not have the keyboard focus (the prev/next
                 buttons take it), where the default one nearly vanishes. -->
            <ListBox x:Name="listbox_testcase" Grid.Row="1" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="測試案例" SelectionChanged="listbox_testcase_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2,3"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E6E6E6"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent"
                                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#CCE8FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
        
        <Grid Grid.Row="0" Margin="4,2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style x:Key="FieldLabel" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="2,0,8,0"/>
                </Style>
                <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#CCE8FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>


            <TextBlock Grid.Row="1" Text="測試案例" Style="{StaticResource FieldLabel}"/>
            <!-- The description of the chosen test case in one line; in the list it wraps over several lines. -->
            <TextBlock x:Name="textblock_testcase" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="2"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding SelectedItem.DisplayName, ElementName=listbox_testcase}"/>
            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                <Button x:Name="button_prev" Content="上一個" Margin="2" Padding="10,3" Click="button_prev_Click"/>
                <Button x:Name="button_next" Content="下一個" Margin="2" Padding="10,3" Click="button_next_Click"/>
                <Button x:Name="button_recompare" Content="重新比對" Margin="2" Padding="10,3" Click="button_recompare_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="內容" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="2,6,8,0"/>
            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- The settings of the panel. They stay disabled until a test case is shown. A ComboBox or a CheckBox applies
                     its change at once, a number box after a short typing pause (a number that is not valid or below 0 tints
                     the box and is not applied). An empty RowGap/ColumnGap is null: the same as Gap. -->
                <Grid x:Name="grid_properties" IsEnabled="False" VerticalAlignment="Top" Margin="0,0,4,0">
                    <Grid.Resources>
                        <Style x:Key="PropertyLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                            <Setter Property="Margin" Value="2,0,6,0"/>
                        </Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Margin" Value="1"/>
                            <Setter Property="Padding" Value="4,1"/>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Margin" Value="1"/>
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <!-- With a Chinese IME on, the "." of a decimal number would be typed as "。". -->
                            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
                        </Style>
                        <!-- The hint in an empty number box, like the one of the search box; it follows the Text of its box through Tag. -->
                        <Style x:Key="EmptyHint" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Setter Property="Margin" Value="6,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Direction" Style="{StaticResource PropertyLabel}"/>
                    <ComboBox x:Name="combobox_direction" Grid.Column="1" AutomationProperties.Name="Direction"
                              SelectionChanged="property_SelectionChanged"/>
                    <TextBlock Grid.Column="3" Text="Wrap" Style="{StaticResource PropertyLabel}"/>
                    <ComboBox x:Name="combobox_wrap" Grid.Column="4" AutomationProperties.Name="Wrap"
                              SelectionChanged="property_SelectionChanged"/>

                    <TextBlock Grid.Row="1" Text="JustifyContent" Style="{StaticResource PropertyLabel}"/>
                    <ComboBox x:Name="combobox_justifycontent" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="JustifyContent"
                              SelectionChanged="property_SelectionChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="AlignItems" Style="{StaticResource PropertyLabel}"/>
                    <ComboBox x:Name="combobox_alignitems" Grid.Row="1" Grid.Column="4" AutomationProperties.Name="AlignItems"
                              SelectionChanged="property_SelectionChanged"/>

                    <TextBlock Grid.Row="2" Text="AlignContent" Style="{StaticResource PropertyLabel}"/>
                    <ComboBox x:Name="combobox_aligncontent" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="AlignContent"
                              SelectionChanged="property_SelectionChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Gap" Style="{StaticResource PropertyLabel}"/>
                    <TextBox x:Name="textbox_gap" Grid.Row="2" Grid.Column="4" AutomationProperties.Name="Gap"
                             ToolTip="Gap (px, 0 或以上): 項目之間的間距,也是 RowGap/ColumnGap 留空時的值"
                             TextChanged="property_TextChanged"/>

                    <TextBlock Grid.Row="3" Text="RowGap" Style="{StaticResource PropertyLabel}"/>
                    <Grid Grid.Row="3" Grid.Column="1">
                        <TextBox x:Name="textbox_rowgap" AutomationProperties.Name="RowGap"
                                 ToolTip="RowGap (px, 0 或以上): 上下方向的間距,留空表示使用 Gap"
                                 TextChanged="property_TextChanged"/>
                        <TextBlock Text="同 Gap" Tag="{Binding Text, ElementName=textbox_rowgap}" Style="{StaticResource EmptyHint}"/>
                    </Grid>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="ColumnGap" Style="{StaticResource PropertyLabel}"/>
                    <Grid Grid.Row="3" Grid.Column="4">
                        <TextBox x:Name="textbox_columngap" AutomationProperties.Name="ColumnGap"
                                 ToolTip="ColumnGap (px, 0 或以上): 左右方向的間距,留空表示使用 Gap"
                                 TextChanged="property_TextChanged"/>
                        <TextBlock Text="同 Gap" Tag="{Binding Text, ElementName=textbox_columngap}" Style="{StaticResource EmptyHint}"/>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="Padding" Style="{StaticResource PropertyLabel}" ToolTip="Padding (px, 0 或以上): 由左至右依序為 左、上、右、下"/>
                    <UniformGrid Grid.Row="4" Grid.Column="1" Columns="4">
                        <TextBox x:Name="textbox_padding_left" AutomationProperties.Name="Padding Left" ToolTip="Padding Left (px, 0 或以上)"
                                 TextChanged="property_TextChanged"/>
                        <TextBox x:Name="textbox_padding_top" AutomationProperties.Name="Padding Top" ToolTip="Padding Top (px, 0 或以上)"
                                 TextChanged="property_TextChanged"/>
                        <TextBox x:Name="textbox_padding_right" AutomationProperties.Name="Padding Right" ToolTip="Padding Right (px, 0 或以上)"
                                 TextChanged="property_TextChanged"/>
                        <TextBox x:Name="textbox_padding_bottom" AutomationProperties.Name="Padding Bottom" ToolTip="Padding Bottom (px, 0 或以上)"
                                 TextChanged="property_TextChanged"/>
                    </UniformGrid>
                    <StackPanel Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="checkbox_scroll_horizontal" Content="水平捲軸" Margin="2,0,10,0"
                                  AutomationProperties.Name="水平捲軸" ToolTip="Parent.EnableHorizontalScrollbar"
                                  Checked="property_CheckedChanged" Unchecked="property_CheckedChanged"/>
                        <CheckBox x:Name="checkbox_scroll_vertical" Content="垂直捲軸"
                                  AutomationProperties.Name="垂直捲軸" ToolTip="Parent.EnableVerticalScrollbar"
                                  Checked="property_CheckedChanged" Unchecked="property_CheckedChanged"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="textbox_content" Grid.Column="1" Height="136" Margin="2" Padding="4,2"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" Background="White"
                         AutomationProperties.Name="測試案例內容 (JSON，可編輯，不會寫回檔案)"
                         TextChanged="textbox_content_TextChanged"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" UseLayoutRounding="True" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="scrollviewer_flexpanel" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                <!-- The items keep the fractional positions the panel computes, which is what is compared with the CSS layout. -->
                <qpanel:FlexPanel x:Name="flexpanel" UseLayoutRounding="False"/>
            </ScrollViewer>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock TextAlignment="Center" VerticalAlignment="Center">
                    <Run Text="WPF"/><LineBreak/>
                    <Run Text="←"/>
                </TextBlock>
                <TextBlock Grid.Row="1" TextAlignment="Center" VerticalAlignment="Center">
                    <Run Text="Web"/><LineBreak/>
                    <Run Text="→"/>
                </TextBlock>
            </Grid>
            
            <webview:WebView2 x:Name="web" Grid.Column="2"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="4" Grid.Column="1">
            <TextBlock x:Name="textblock_summary" FontWeight="Bold" Margin="0,2"/>
            <ListView x:Name="listview_comparison" Height="180">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" Width="30" DisplayMemberBinding="{Binding Index}"/>
                        <GridViewColumn Header="WPF (X, Y, W, H)" Width="200" DisplayMemberBinding="{Binding WpfRect}"/>
                        <GridViewColumn Header="Web (X, Y, W, H)" Width="200" DisplayMemberBinding="{Binding WebRect}"/>
                        <GridViewColumn Header="Diff (X, Y, W, H)" Width="180" DisplayMemberBinding="{Binding DeltaRect}"/>
                        <GridViewColumn Header="結果" Width="80" DisplayMemberBinding="{Binding StatusText}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                <Setter Property="Background" Value="#FBD9D9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                <Setter Property="Background" Value="#DCF3DC"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </StackPanel>
    </Grid>
</Window>
